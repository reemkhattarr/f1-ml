# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- uv / virtualenv ---
.venv/
# uv.lock IS committed (reproducible installs) — do not ignore it.

# --- Tooling caches ---
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyright/
.coverage
htmlcov/

# --- Data & artifacts (managed by DVC, not git) ---
# FastF1 cache and all raw/processed data live outside git.
**/data/
!**/data/.gitkeep
# ...but NOT the `data` source *package* (src/<pkg>/data/) — that is code.
!**/src/**/data/
!**/src/**/data/**
# keep bytecode caches out even inside the re-included source package
**/__pycache__/
**/mlflow/
**/artifacts/
**/space_build/
**/explorer_space_build/
mlruns/
mlartifacts/
*.pkl
*.joblib
*.pt
*.onnx

# --- Notebooks ---
.ipynb_checkpoints/

# --- Env & secrets ---
.env
.env.*
!.env.example

# --- Claude Code (machine-local settings + transient locks) ---
.claude/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
